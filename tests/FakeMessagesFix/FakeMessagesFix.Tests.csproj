<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath>$(MSBuildThisFileDirectory)build/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Fixes.csproj" />
    <!-- CS2 supplies this dependency in production; this harness runs outside the server. -->
    <PackageReference Include="SwiftlyS2.CS2" Version="*-*" />
  </ItemGroup>
</Project>
